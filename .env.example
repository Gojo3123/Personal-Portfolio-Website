# ---------------------------------------------------------------
# Firebase configuration (REQUIRED for authentication & cloud data)
# Create a project at https://console.firebase.google.com
# Then: Project settings -> General -> Your apps -> Web app -> Config
# Copy the values below into a local `.env` file.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ---------------------------------------------------------------
# Admin access control (comma separated lowercase emails).
# These emails receive the `admin` role after they sign up.
# Security is ENFORCED by Firestore rules (see firestore.rules) —
# never trust this list alone on the client.
# ---------------------------------------------------------------
VITE_ADMIN_EMAILS=you@example.com
